# Server HTTP Port
PORT=5000

# Environment Mode (development, production, test)
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/CampusSphere?retryWrites=true&w=majority

# Access Token Signing Secret (Min 32 Characters)
JWT_SECRET=your_32_character_minimum_access_token_secret_key

# Refresh Token Signing Secret (Min 32 Characters)
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_token_secret_key

# JWT Access Token Expiry Duration (e.g., 15m, 1h)
ACCESS_TOKEN_EXPIRY=15m

# JWT Refresh Token Expiry Duration (e.g., 7d, 30d)
REFRESH_TOKEN_EXPIRY=7d
